{
  "name": "asymptote-lsp",
  "displayName": "Asymptote Language Support",
  "description": "LSP-based Asymptote language support with syntax highlighting, code completion for imported modules, real-time diagnostics, hover, go-to-definition, cross-module references, rename, formatting, and compile/preview",
  "version": "0.2.5",
  "publisher": "asy",
  "license": "MIT",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/doombeaker/AsyLsp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "asymptote",
    "asy",
    "vector graphics",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:asymptote"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "asymptote.compile",
        "title": "Asymptote: Compile",
        "icon": "$(run)"
      },
      {
        "command": "asymptote.preview",
        "title": "Asymptote: Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "asymptote.setFormat.svg",
        "title": "SVG",
        "icon": "$(file-media)"
      },
      {
        "command": "asymptote.setFormat.pdf",
        "title": "PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "asymptote.setFormat.png",
        "title": "PNG",
        "icon": "$(file-media)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "asymptote.compile",
          "when": "editorLangId == asymptote",
          "group": "navigation@1"
        },
        {
          "command": "asymptote.preview",
          "when": "editorLangId == asymptote",
          "group": "navigation@2"
        },
        {
          "submenu": "asymptote.formatMenu",
          "when": "editorLangId == asymptote",
          "group": "navigation@3"
        }
      ],
      "asymptote.formatMenu": [
        {
          "command": "asymptote.setFormat.svg",
          "group": "inline"
        },
        {
          "command": "asymptote.setFormat.pdf",
          "group": "inline"
        },
        {
          "command": "asymptote.setFormat.png",
          "group": "inline"
        }
      ]
    },
    "submenus": [
      {
        "id": "asymptote.formatMenu",
        "label": "Format",
        "icon": "$(file-media)"
      }
    ],
    "languages": [
      {
        "id": "asymptote",
        "aliases": [
          "Asymptote",
          "asy"
        ],
        "extensions": [
          ".asy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asymptote",
        "scopeName": "source.asy",
        "path": "./syntaxes/asymptote.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Asymptote",
      "properties": {
        "asymptote.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Asymptote language server."
        },
        "asymptote.asyPath": {
          "type": "string",
          "default": "asy",
          "description": "Path to the Asymptote (asy) executable."
        },
        "asymptote.searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional search paths for resolving import/include/access statements. Directories are searched in order. Supports ~ for home directory and environment variable expansion."
        },
        "asymptote.autoimport": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Modules to automatically import in all Asymptote files (equivalent to the autoimport setting in Asymptote config). These modules are treated as implicitly imported for language server features like completion, hover, and go-to-definition."
        },
        "asymptote.formatting.braceStyle": {
          "type": "string",
          "enum": [
            "kr",
            "allman"
          ],
          "default": "kr",
          "description": "Brace style for formatting. 'kr' places opening brace on the same line, 'allman' on a new line."
        },
        "asymptote.formatting.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of spaces for indentation."
        },
        "asymptote.formatting.insertSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Use spaces instead of tabs for indentation."
        },
        "asymptote.formatting.pathExpressionSpacing": {
          "type": "string",
          "enum": [
            "compact",
            "spaced"
          ],
          "default": "spaced",
          "description": "Spacing around path expression operators (.., --, ---, :). 'compact' removes spaces, 'spaced' adds spaces."
        },
        "asymptote.compile.outputFormat": {
          "type": "string",
          "enum": [
            "svg",
            "pdf",
            "png"
          ],
          "default": "svg",
          "description": "Output format for compilation. SVG is recommended for inline preview."
        },
        "asymptote.compile.render": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Raster render resolution in pixels per bp (PNG only). Higher values produce sharper PNG output but increase file size and compile time. SVG and PDF are vector formats and ignore this setting. Recommended range: 4–8."
        },
        "asymptote.compile.outputDir": {
          "type": "string",
          "default": "",
          "description": "Output directory for compiled files. Leave empty to use the same directory as the source file."
        },
        "asymptote.compile.autoCompile": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compile on save."
        },
        "asymptote.compile.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line arguments to pass to asy (e.g., ['-render=4'])."
        },
        "asymptote.compile.openPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open preview after successful compilation."
        }
      }
    },
    "snippets": [
      {
        "language": "asymptote",
        "path": "./snippets/asymptote.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
